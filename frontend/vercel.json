{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/profile/:id",
      "destination": "/api/share-profile?id=:id"
    },
    {
      "source": "/share/profile/:id/",
      "destination": "/api/share-profile?id=:id"
    },
    {
      "source": "/share/project/:id",
      "destination": "/api/share-project?id=:id"
    },
    {
      "source": "/share/project/:id/",
      "destination": "/api/share-project?id=:id"
    },
    {
      "source": "/share/gift/:id",
      "destination": "/api/share-gift?id=:id"
    },
    {
      "source": "/share/gift/:id/",
      "destination": "/api/share-gift?id=:id"
    },
    {
      "source": "/share/plastic-pulse",
      "destination": "/api/share-plastic-pulse"
    },
    {
      "source": "/share/plastic-pulse/",
      "destination": "/api/share-plastic-pulse"
    },
    {
      "source": "/share/page",
      "destination": "/api/share-page"
    },
    {
      "source": "/share/page/",
      "destination": "/api/share-page"
    },
    {
      "source": "/plastic-pulse",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|embedly|pinterest|quora link preview|googlebot|bingbot|applebot|yandexbot|duckduckbot|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/share-plastic-pulse"
    },
    {
      "source": "/plastic-pulse/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|embedly|pinterest|quora link preview|googlebot|bingbot|applebot|yandexbot|duckduckbot|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/share-plastic-pulse"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|embedly|pinterest|quora link preview|googlebot|bingbot|applebot|yandexbot|duckduckbot|bot|crawler|spider).*"
