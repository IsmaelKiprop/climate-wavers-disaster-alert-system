# notification_service — ALL of these are required at startup (Joi)
# cp .env.example .env

PORT=3000
AMQP_URL=amqp://admin:admin@localhost:5672/

SERVER_PORT=3000
SERVER_HOST=localhost
SERVER_PROTOCOL=http
SERVER_SECRET=change-me-local-server-secret

# SMTP (Gmail: use an app password, not the account password)
MAIL_USER=your@email.com
MAIL_PASS=your-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SERVICE=gmail
MAIL_FROM=Climate Wavers <your@email.com>

# Firebase (optional locally)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Meta WhatsApp Cloud API — reuse FlowOps Africa number (+254 117 547546)
# App: FlowOps Africa WA (1039347192289042) → WhatsApp → API setup
# Leave Meta webhook on FlowOps/Grace; alerts only need TOKEN + PHONE_NUMBER_ID.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=1217474324793670
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
META_WA_TEMPLATE_LANG=en
