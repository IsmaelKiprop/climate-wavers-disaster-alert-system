<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof headline !== 'undefined' && headline ? headline : (typeof subject !== 'undefined' && subject ? subject : 'Climate Wavers') %></title>
  <!--[if mso]><style>table,td{font-family:Arial,Helvetica,sans-serif !important;}</style><![endif]-->
</head>
<body style="margin:0;padding:0;background:#f3f4f4;">
  <%
    var brand = '#067d83';
    var brandSoft = '#e8f5f5';
    var brandBorder = '#9fd4d7';
    var ink = '#111111';
    var muted = '#6b7280';
    var base = (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl : 'https://alerts.flowops.africa';
    var logo = (typeof logoUrl !== 'undefined' && logoUrl) ? logoUrl : (base + '/logo.jpg');
    var hero = (typeof hero_image !== 'undefined' && hero_image) ? hero_image : (base + '/environment.jpg');
    var greet = (typeof name !== 'undefined' && name) ? name : ((typeof first_name !== 'undefined' && first_name) ? first_name : 'there');
    var title = (typeof headline !== 'undefined' && headline) ? headline : ((typeof subject !== 'undefined' && subject) ? subject : 'A note from Climate Wavers');
    var ctaLabel = (typeof cta_text !== 'undefined' && cta_text) ? cta_text : 'Open Climate Wavers';
    var ctaHref = (typeof cta_url !== 'undefined' && cta_url) ? cta_url : ((typeof link !== 'undefined' && link) ? link : base);
    var soft = (typeof reply_hint !== 'undefined' && reply_hint) ? reply_hint : 'Prefer some help? Reply to this email and the Climate Wavers team will follow up.';
    var year = new Date().getFullYear();
    var raw = String(typeof content !== 'undefined' ? content : '');
    var blocks = raw.replace(/\r\n/g, '\n').trim().split(/\n\s*\n/);
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function linkify(escaped) {
      return escaped.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
        return '<a href="' + url + '" style="color:' + brand + ';text-decoration:underline;font-weight:700;">' + url + '</a>';
      });
    }
  %>
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
    <%= typeof preheader !== 'undefined' && preheader ? preheader : title %>
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f3f4f4;">
    <tr>
      <td align="center" style="padding:28px 16px 40px;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;">
          <tr>
            <td align="center" style="padding:0 0 14px;">
              <img src="<%= logo %>" width="56" height="56" alt="Climate Wavers" style="display:block;width:56px;height:56px;border-radius:50%;border:2px solid #111;object-fit:cover;background:#fff;" />
            </td>
          </tr>
          <tr>
            <td style="background:#ffffff;border:1px solid #111111;border-radius:6px;overflow:hidden;">
              <img src="<%= hero %>" width="560" alt="" style="display:block;width:100%;max-width:560px;height:auto;border:0;" />
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding:28px 28px 8px;font-family:Arial,Helvetica,sans-serif;">
                    <p style="margin:0 0 18px;font-size:15px;line-height:1.5;color:<%= ink %>;">Hi <%= esc(greet) %>,</p>
                    <h1 style="margin:0 0 18px;font-size:26px;line-height:1.25;font-weight:800;color:<%= ink %>;"><%= esc(title) %></h1>
                    <% blocks.forEach(function (chunk) {
                      var lines = String(chunk).split('\n').map(function (line) { return esc(line); });
                      var body = linkify(lines.join('<br>'));
                    %>
                      <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:<%= ink %>;"><%- body %></p>
                    <% }) %>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 22px;">
                      <tr>
                        <td style="background:<%= brandSoft %>;border:1px solid <%= brandBorder %>;border-radius:4px;padding:14px 16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:<%= ink %>;">
                          <%= esc(soft) %>
                          <br />
                          <a href="<%= ctaHref %>" style="color:<%= brand %>;font-weight:700;text-decoration:underline;"><%= esc(ctaLabel) %></a>
                        </td>
                      </tr>
                    </table>
                    <p style="margin:0 0 6px;font-size:15px;line-height:1.5;color:<%= ink %>;">With care for the planet,</p>
                    <p style="margin:0 0 8px;font-size:15px;line-height:1.5;color:<%= ink %>;font-weight:700;">Climate Wavers Team</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:22px 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:<%= muted %>;">
              Climate Wavers by FlowOps Africa<br />
              <a href="<%= base %>/app/alert-settings" style="color:<%= muted %>;text-decoration:underline;">Email preferences</a>
              &nbsp;|&nbsp;
              <a href="<%= base %>" style="color:<%= muted %>;text-decoration:underline;">alerts.flowops.africa</a>
              <br />
              © <%= year %> Climate Wavers
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
