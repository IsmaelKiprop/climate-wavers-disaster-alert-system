# Django — copy to .env and fill values
# cp .env.example .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
BASE_URL=http://127.0.0.1:8000
# Single origin only (not a comma list). Production example:
# FRONTEND_URL=https://alerts.flowops.africa
FRONTEND_URL=http://localhost:5173
BACKEND_HOST=http://127.0.0.1:8000

# CORS / CSRF
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (comma-separated regexes):
# CORS_ORIGIN_REGEXES=^https://.*\.vercel\.app$,^https://([a-z0-9-]+\.)?flowops\.africa$
CORS_ORIGIN_REGEXES=^https://.*\.vercel\.app$,^https://([a-z0-9-]+\.)?flowops\.africa$

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-fernet-key

# Default avatars (any public image URLs)
MALE_AVATAR=https://ui-avatars.com/api/?name=M&background=0D8ABC&color=fff
FEMALE_AVATAR=https://ui-avatars.com/api/?name=F&background=E91E63&color=fff

# Database
# Local: leave DATABASE_URL empty to use SQLite
# SQLITE_PATH=db.sqlite3
#
# Production (Supabase): Project Settings > Database > Connection string
# Prefer the "Session pooler" URI (port 5432) for Django migrations.
# Transaction pooler (port 6543) also works; Django disables server-side cursors automatically.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_SSL_REQUIRE=True

# Media storage
# local = disk (default). supabase/s3 = Supabase Storage via S3 API
STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=media
# AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=PROJECT_REF.supabase.co/storage/v1/object/public/media

# Redis (optional locally — Channels falls back to in-memory if missing)
REDIS=redis://localhost:6379/0
REDIS_USE_SSL=False

# RabbitMQ (needed for emails + AI post ingest)
AMQP_URL=amqp://admin:admin@localhost:5672/
NOTIFICATION_SERVICE_URL=https://climate-wavers-notifications.onrender.com
NOTIFICATION_SECRET=change-me-server-secret
# MAIL_USER=
# MAIL_PASS=
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_FROM=hello@climatewavers.org

# Meta WhatsApp (phone OTP / alerts — same FlowOps number)
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=1217474324793670
# META_WA_TEMPLATE_LANG=en

# Optional integrations
# OPENAI_API_KEY=
# PAYSTACK_SECRET_KEY=
# OPENWEATHER_API_KEY=
# NEWS_API_KEY=
# TWITTER_BEARER_TOKEN=
# WaverX broadcasts are FREE via the in-app feed (default).
# Paid X API posting is OFF — do not enable unless you accept X pay-per-post fees.
# WAVERX_TWITTER_ENABLED=false
# WAVERX_MIRROR_FEED=true
# WAVERX_USERNAME=waverx
# WAVERX_EMAIL=waverx@climatewavers.org
# Optional public HTTPS avatar/cover (defaults to teal WaverX avatar + nature cover)
# WAVERX_AVATAR_URL=https://your-cdn/waverx-avatar.png
# WAVERX_COVER_URL=https://your-cdn/waverx-cover.jpg
# WAVERX_TWITTER_AI_POLISH=false

# RESEND_API_KEY=
